# EdgeDash Environment Variables

# Gemini API (get from https://ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key-here

# Hosted Postgres connection string. Leave unset for local SQLite development.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional deployed repository link shown in the dashboard footer.
GITHUB_REPO_URL=https://github.com/your-org/edgedash

# Ollama (local, no key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral
